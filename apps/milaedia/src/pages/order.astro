---
import Base from '../layouts/Base.astro';
import SalonHeader from '../components/hero/SalonHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GhostButton from '../components/primitives/GhostButton.astro';
import Ornament from '../components/primitives/Ornament.astro';
---
<Base title="Order received — MiLAEDiA" description="Your request has been recorded.">
  <SalonHeader />
  <main id="main" class="frame conf">
    <Ornament variant="medallion" size="4.5rem" class="conf-mark" />
    <h1>Thank you</h1>
    <p class="ref">Reference <strong data-ref>—</strong></p>
    <p class="body" data-conf-body>
      Your request has been recorded. Payment is not yet connected on this
      deployment, so nothing has been charged. The atelier will confirm
      availability, freight and the final total before any payment is taken.
    </p>
    <ul class="lines" data-conf-lines role="list"></ul>
    <GhostButton href="/collections">Continue browsing</GhostButton>
  </main>
  <SiteFooter />
</Base>

<style>
  .conf { display:grid; justify-items:center; text-align:center; gap:1.4rem;
    padding-block: clamp(3rem, 8vh, 6rem) clamp(4rem,10vh,8rem); max-inline-size: 56ch; margin-inline:auto; }
  .conf :global(.conf-mark) { color: var(--gold); }
  h1 { margin:0; font-family: var(--font-display); font-weight:300;
    font-size: clamp(2.2rem,5.5vw,4rem); color:#EDE7DA; }
  .ref { margin:0; font-family: var(--font-display); font-size: var(--type-card-link);
    letter-spacing: var(--track-nav); text-transform: uppercase; color: var(--silver); }
  .ref strong { color: var(--gold-hi); font-weight:400; }
  .body { margin:0; font-family: var(--font-display); font-size:1.05rem; line-height:1.9; color: var(--silver); }
  .lines { list-style:none; margin:0; padding:1.2rem 0; display:grid; gap:.6em;
    inline-size:100%; border-block:1px solid var(--hairline-soft);
    font-family: var(--font-display); font-size: var(--type-card-link); color: var(--silver); }
</style>

<script>
  const params = new URLSearchParams(location.search);
  const ref = params.get('ref') || '—';
  document.querySelector('[data-ref]')!.textContent = ref;
  try {
    const raw = sessionStorage.getItem('milaedia:last-order');
    if (raw) {
      const o = JSON.parse(raw);
      const fmt = (m: number) => new Intl.NumberFormat('en-DE',
        { style:'currency', currency:'EUR', maximumFractionDigits:0 }).format(m/100);
      document.querySelector('[data-conf-lines]')!.innerHTML =
        o.lines.map((l: any) => `<li>${l.title} × ${l.qty} — ${fmt(l.priceMinor*l.qty)}</li>`).join('');
    }
  } catch {}
</script>
