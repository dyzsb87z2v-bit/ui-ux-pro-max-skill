---
import Base from '../layouts/Base.astro';
import SalonHeader from '../components/hero/SalonHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GhostButton from '../components/primitives/GhostButton.astro';
import Divider from '../components/primitives/Divider.astro';
---
<Base title="Your bag — MiLAEDiA" description="Your selected pieces.">
  <SalonHeader />
  <main id="main" class="frame">
    <header class="bhead">
      <h1 class="btitle">Your Bag</h1>
      <Divider class="bhead-divider" />
    </header>

    <div class="empty" data-bag-empty>
      <p>Your bag is empty.</p>
      <GhostButton href="/collections">View the collections</GhostButton>
    </div>

    <div class="layout" data-bag-layout hidden>
      <ul class="lines" data-bag-lines role="list"></ul>
      <aside class="totals panel">
        <h2 data-uppercase>Summary</h2>
        <dl>
          <dt>Subtotal</dt><dd data-bag-subtotal>—</dd>
          <dt>Shipping</dt><dd data-bag-shipping>Quoted after checkout</dd>
          <dt class="grand">Total</dt><dd class="grand" data-bag-total>—</dd>
        </dl>
        <p class="vat">Prices include VAT where applicable.</p>
        <GhostButton href="/checkout" class="go">Proceed to checkout</GhostButton>
      </aside>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .bhead { padding-block: clamp(2.5rem, 7vh, 5rem) clamp(1.5rem,4vh,3rem); display:grid; gap:1rem; }
  .btitle { margin:0; font-family: var(--font-display); font-weight:300;
    font-size: clamp(2.4rem,6vw,4.6rem); line-height:1; color:#EDE7DA; }
  .bhead :global(.bhead-divider) { inline-size: min(340px,60%); }
  .empty { display:grid; gap:1.6rem; justify-items:start; padding-block: 3rem 8rem; }
  .empty p { margin:0; font-family: var(--font-display); font-size:1.15rem; color: var(--silver); }
  .layout { display:grid; grid-template-columns: minmax(0,1.6fr) minmax(0,1fr);
    gap: clamp(1.5rem,4vw,3.5rem); padding-block-end: clamp(3rem,8vh,6rem); align-items:start; }
  .lines { list-style:none; margin:0; padding:0; display:grid; gap:1px; background: var(--hairline-soft);
    border:1px solid var(--hairline-soft); border-radius: var(--radius); overflow:hidden; }
  .totals { padding: clamp(1.2rem,3vw,2rem); display:grid; gap:1rem; position:sticky; top: clamp(72px,10vh,110px); }
  .totals h2 { margin:0; font-family: var(--font-display); font-weight:400;
    font-size: var(--type-descriptor); letter-spacing: var(--track-cities); color: var(--bronze); }
  .totals dl { display:grid; grid-template-columns:1fr auto; gap:.7em 1rem; margin:0;
    font-family: var(--font-display); font-size: var(--type-card-link); }
  .totals dt { color: var(--silver); } .totals dd { margin:0; color: var(--silver-hi); font-variant-numeric: tabular-nums; }
  .totals .grand { color: var(--gold-hi); font-size:1.1em; padding-block-start:.6em;
    border-block-start:1px solid var(--hairline-soft); }
  .vat { margin:0; font-size: var(--type-descriptor); color: var(--silver); opacity:.55;
    font-family: var(--font-display); }
  @media (max-width: 900px) { .layout { grid-template-columns:1fr; } .totals { position:static; } }
</style>

<script>
  import { getBag, setQty, removeLine, subtotal, onBagChange } from '../lib/bag';

  const fmt = (m: number, c = 'EUR') =>
    new Intl.NumberFormat('en-DE', { style:'currency', currency:c, maximumFractionDigits:0 }).format(m/100);

  const linesEl = document.querySelector<HTMLElement>('[data-bag-lines]')!;
  const layout = document.querySelector<HTMLElement>('[data-bag-layout]')!;
  const emptyEl = document.querySelector<HTMLElement>('[data-bag-empty]')!;

  function render() {
    const lines = getBag();
    layout.hidden = lines.length === 0;
    emptyEl.hidden = lines.length > 0;
    linesEl.innerHTML = lines.map((l) => `
      <li class="line">
        <div class="li-meta">
          <a href="${l.href || '/collections'}" class="li-title">${l.title}</a>
          <span class="li-price">${fmt(l.priceMinor, l.currency)}</span>
        </div>
        <div class="li-ctl">
          <label class="li-qty">
            <span class="visually-hidden">Quantity for ${l.title}</span>
            <input type="number" min="0" max="${l.maxQty}" value="${l.qty}" data-qty="${l.productId}">
          </label>
          <button type="button" data-remove="${l.productId}">Remove</button>
        </div>
      </li>`).join('');

    const sub = subtotal(lines);
    document.querySelector('[data-bag-subtotal]')!.textContent = fmt(sub);
    document.querySelector('[data-bag-total]')!.textContent = fmt(sub);

    linesEl.querySelectorAll<HTMLInputElement>('[data-qty]').forEach((i) =>
      i.addEventListener('change', () => setQty(i.dataset.qty!, Number(i.value))));
    linesEl.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((b) =>
      b.addEventListener('click', () => removeLine(b.dataset.remove!)));
  }

  render();
  onBagChange(render);
</script>

<style is:global>
  .line { display:flex; justify-content:space-between; align-items:center; gap:1.5rem;
    padding: 1.2rem 1.4rem; background: var(--panel); flex-wrap: wrap; }
  .li-meta { display:grid; gap:.35em; }
  .li-title { font-family: var(--font-display); font-size: var(--type-card-title);
    color: var(--silver-hi); text-decoration:none; letter-spacing: var(--track-card); }
  .li-price { font-family: var(--font-display); font-size: var(--type-card-link);
    color: var(--gold); font-variant-numeric: tabular-nums; }
  .li-ctl { display:flex; gap:1rem; align-items:center; }
  .li-qty input { inline-size:4.5em; background: var(--ground); color: var(--silver-hi);
    border:1px solid var(--hairline); border-radius:5px; padding:.5em .6em;
    font-family: var(--font-display); text-align:center; }
  .li-ctl button { background:none; border:0; color: var(--silver); cursor:pointer;
    font-family: var(--font-display); font-size: var(--type-card-link);
    border-block-end:1px solid var(--hairline); padding-block-end:2px; }
  .li-ctl button:hover { color: var(--gold-hi); }
</style>
