---
import Base from "../layouts/Base.astro";
import SalonHeader from '../components/hero/SalonHeader.astro';
import SiteFooter from "../components/SiteFooter.astro";
import Divider from "../components/primitives/Divider.astro";
import GhostButton from "../components/primitives/GhostButton.astro";
import { Picture } from "astro:assets";
import { scene } from "../lib/images";
---
<Base title="Workshop — MiLAEDiA" description="A hand-knotted rug is made one knot at a time. A large piece can take a weaver more than a year.">
  <SalonHeader current="/workshop" />
  <main id="main" class="frame ed">
    <header class="ehead">
      <div class="etext">
        <p class="eyebrow" data-uppercase>The Craft</p>
        <h1>Workshop</h1>
        <p class="lede">A hand-knotted rug is made one knot at a time. A large piece can take a weaver more than a year.</p>
        <Divider class="e-divider" />
      </div>
      <div class="eimg">
        <Picture src={scene.weaverStill} alt="" widths={[420, 840]} sizes="44vw"
                 formats={["avif"]} fallbackFormat="webp" quality={66} loading="eager" />
      </div>
    </header>

    <div class="chunks" data-reveal>
      <section class="chunk"><h2>The loom</h2><p>Warps are dressed on the loom before a single knot is tied. The tension set at this stage determines whether the finished piece lies flat.</p></section>
      <section class="chunk"><h2>The knot</h2><p>Persian weaving uses an asymmetric knot, tied around two warps. Density is counted per square metre; the finest silk work approaches a million.</p></section>
      <section class="chunk"><h2>Dye and light</h2><p>Natural dyes shift with the batch and settle unevenly over decades. That unevenness — abrash — is a record of the piece, not a flaw in it.</p></section>
      <section class="chunk"><h2>Finishing</h2><p>The pile is sheared, the piece washed, the edges bound and the fringe secured by hand. Only then is it measured and recorded.</p></section>
    </div>

    <div class="cta" data-reveal>
      <GhostButton href="/collections">
        View the collections
      </GhostButton>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .ehead { display:grid; grid-template-columns: minmax(0,1fr) minmax(0,.85fr);
    gap: clamp(1.5rem,5vw,4rem); align-items:center;
    padding-block: clamp(2.5rem, 7vh, 5rem) clamp(2rem,6vh,4rem); }
  .etext { display:grid; gap:1.1rem; justify-items:start; }
  .eyebrow { margin:0; font-family: var(--font-display); font-size: var(--type-descriptor);
    letter-spacing: var(--track-cities); text-transform:uppercase; color: var(--bronze); }
  h1 { margin:0; font-family: var(--font-display); font-weight:300;
    font-size: clamp(2.6rem,7vw,5.4rem); line-height:1; color:#EDE7DA; }
  .lede { margin:0; font-family: var(--font-display); font-size: clamp(1.05rem,1.6vw,1.3rem);
    line-height:1.9; color: var(--silver); max-inline-size:44ch; }
  .etext :global(.e-divider) { inline-size: min(320px,70%); }
  .eimg { border:1px solid var(--hairline); border-radius: var(--radius); overflow:hidden; aspect-ratio:4/5; }
  .eimg :global(img) { inline-size:100%; block-size:100%; object-fit:cover; }

  .chunks { display:grid; grid-template-columns: repeat(auto-fit, minmax(280px,1fr));
    gap: clamp(2rem,5vw,4rem); padding-block: clamp(1rem,4vh,3rem); }
  .chunk h2 { margin:0 0 .7em; font-family: var(--font-display); font-weight:400;
    font-size: clamp(1.15rem,2vw,1.5rem); color:#EDE7DA; }
  .chunk p { margin:0; font-family: var(--font-display); font-size:1rem;
    line-height:1.95; color: var(--silver); }
  .cta { padding-block: clamp(2rem,6vh,4rem) clamp(4rem,10vh,7rem); }
  @media (max-width: 900px) { .ehead { grid-template-columns:1fr; } .eimg { aspect-ratio:3/2; } }
</style>
