---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Divider from "../../components/primitives/Divider.astro";
---
<Base title="Shipping & Returns — MiLAEDiA" description="Versand und Rücksendungen">
  <SiteHeader />
  <main id="main" class="frame legal">
    <header class="lhead">
      <p class="eyebrow" data-uppercase>Versand und Rücksendungen</p>
      <h1>Shipping & Returns</h1>
      <Divider class="l-divider" />
    </header>
    <p class="warn">Values marked PLACEHOLDER are business inputs and must be set before launch.</p>
    <div class="lbody">
      <section class="lrow"><h2>Freight</h2><p>Pieces ship crated and fully insured. Freight is quoted per destination once the order is placed — a rug is not a parcel.</p></section>
      <section class="lrow"><h2>Lead time</h2><p>In-stock pieces despatch within PLACEHOLDER working days. Commissions follow the schedule agreed at the loom.</p></section>
      <section class="lrow"><h2>Delivery</h2><p>PLACEHOLDER — whether delivery includes placement in the room.</p></section>
      <section class="lrow"><h2>Returns</h2><p>PLACEHOLDER — return window and condition, consistent with the Widerrufsbelehrung.</p></section>
      <section class="lrow"><h2>Damage in transit</h2><p>PLACEHOLDER — the notification window and process.</p></section>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .legal { padding-block: clamp(90px,14vh,170px) clamp(4rem,10vh,8rem); max-inline-size: 74ch; }
  .lhead { display:grid; gap:1rem; margin-block-end:2rem; }
  .eyebrow { margin:0; font-family: var(--font-display); font-size: var(--type-descriptor);
    letter-spacing: var(--track-cities); text-transform:uppercase; color: var(--bronze); }
  h1 { margin:0; font-family: var(--font-display); font-weight:300;
    font-size: clamp(2.2rem,5.5vw,4rem); line-height:1.05; color:#EDE7DA; }
  .lhead :global(.l-divider) { inline-size: min(320px,60%); }
  .warn { margin:0 0 2.5rem; padding:1rem 1.2rem; border:1px solid rgba(160,68,42,.45);
    border-radius: var(--radius); background:#0D0705; font-family: var(--font-display);
    font-size: var(--type-card-link); line-height:1.8; color:#C98A6A; }
  .lbody { display:grid; gap:2rem; }
  .lrow h2 { margin:0 0 .5em; font-family: var(--font-display); font-weight:400;
    font-size:1.1rem; color:#EDE7DA; }
  .lrow p { margin:0; font-family: var(--font-display); font-size:.98rem;
    line-height:1.9; color: var(--silver); }
</style>
