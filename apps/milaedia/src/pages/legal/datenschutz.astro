---
import Base from "../../layouts/Base.astro";
import SalonHeader from '../../components/hero/SalonHeader.astro';
import SiteFooter from "../../components/SiteFooter.astro";
import Divider from "../../components/primitives/Divider.astro";
---
<Base title="Datenschutz — MiLAEDiA" description="Privacy policy">
  <SalonHeader />
  <main id="main" class="frame legal">
    <header class="lhead">
      <p class="eyebrow" data-uppercase>Privacy policy</p>
      <h1>Datenschutz</h1>
      <Divider class="l-divider" />
    </header>
    <p class="warn">This page must be completed by someone qualified before launch. The current build stores the bag in localStorage and transmits nothing.</p>
    <div class="lbody">
      <section class="lrow"><h2>Verantwortliche Stelle</h2><p>PLACEHOLDER — controller name and contact details.</p></section>
      <section class="lrow"><h2>Erhobene Daten</h2><p>PLACEHOLDER — describe precisely which data the live deployment collects: contact form fields, order data, and any analytics actually in use.</p></section>
      <section class="lrow"><h2>Rechtsgrundlage</h2><p>PLACEHOLDER — the Art. 6 GDPR basis for each processing purpose.</p></section>
      <section class="lrow"><h2>Speicherdauer</h2><p>PLACEHOLDER — retention periods.</p></section>
      <section class="lrow"><h2>Ihre Rechte</h2><p>Auskunft, Berichtigung, Löschung, Einschränkung, Datenübertragbarkeit und Widerspruch nach Art. 15–21 DSGVO.</p></section>
      <section class="lrow"><h2>Auftragsverarbeiter</h2><p>PLACEHOLDER — hosting, payment and email providers, once selected.</p></section>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .legal { padding-block: clamp(2.5rem, 7vh, 5rem) clamp(4rem,10vh,8rem); max-inline-size: 74ch; }
  .lhead { display:grid; gap:1rem; margin-block-end:2rem; }
  .eyebrow { margin:0; font-family: var(--font-display); font-size: var(--type-descriptor);
    letter-spacing: var(--track-cities); text-transform:uppercase; color: var(--bronze); }
  h1 { margin:0; font-family: var(--font-display); font-weight:300;
    font-size: clamp(2.2rem,5.5vw,4rem); line-height:1.05; color:#EDE7DA; }
  .lhead :global(.l-divider) { inline-size: min(320px,60%); }
  .warn { margin:0 0 2.5rem; padding:1rem 1.2rem; border:1px solid rgba(160,68,42,.45);
    border-radius: var(--radius); background:#0D0705; font-family: var(--font-display);
    font-size: var(--type-card-link); line-height:1.8; color:#C98A6A; }
  .lbody { display:grid; gap:2rem; }
  .lrow h2 { margin:0 0 .5em; font-family: var(--font-display); font-weight:400;
    font-size:1.1rem; color:#EDE7DA; }
  .lrow p { margin:0; font-family: var(--font-display); font-size:.98rem;
    line-height:1.9; color: var(--silver); }
</style>
