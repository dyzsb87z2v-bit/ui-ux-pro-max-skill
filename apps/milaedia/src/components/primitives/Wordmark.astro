---
/**
 * Wordmark — literal text, NEVER text-transform: uppercase.
 * The lowercase `i` at positions 2 and 7 is the brand signature; a
 * transform destroys it. (Forensics §04, §06)
 *
 * Finish: vertical metallic gradient, cap-top #E7CA9C -> baseline #A4855D,
 * plus a very soft warm bloom. Both measured.
 */
import { brand } from '../../data/site';
interface Props {
  as?: 'h1' | 'span' | 'div';
  size?: string;
  class?: string;
  bloom?: boolean;
  /**
   * 'display' is the page's single hero-scale wordmark and is what the
   * 6.2:1 type-ratio invariant measures. Every other lockup (header brand,
   * nav plate) is 'brand' — the same mark, not the display tier.
   */
  role?: 'display' | 'brand';
}
const { as: Tag = 'span', size, class: cls = '', bloom = true, role = 'brand' } = Astro.props;
---
<Tag data-type={role} class={`wordmark ${bloom ? 'bloom' : ''} ${cls}`} style={size ? `font-size:${size}` : undefined}>
  {brand.wordmark}
</Tag>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: var(--track-display);
    line-height: 1;
    background: var(--wordmark-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    display: inline-block;
    /* text-transform is deliberately absent. Do not add it. */
  }
  .bloom { filter: drop-shadow(0 0 0.42em rgba(231, 202, 156, 0.13)); }
</style>
