---
/**
 * Section — the editorial rhythm unit.
 *
 * Not a card grid. `align` sets the composition: 'center' for statements,
 * 'split' for asymmetric editorial pairs, 'wide' for full-bleed plates.
 * Generous vertical space is the point — the measured system is compressed
 * OUTSIDE its panels and spacious INSIDE them.
 */
interface Props {
  eyebrow?: string; title?: string; lede?: string;
  align?: 'center' | 'start'; id?: string; class?: string; tight?: boolean;
}
const { eyebrow, title, lede, align = 'center', id, class: cls = '', tight = false } = Astro.props;
---
<section id={id} class={`sec sec-${align} ${tight ? 'tight' : ''} ${cls}`}>
  {(eyebrow || title || lede) && (
    <header class="sec-head">
      {eyebrow && <p class="eyebrow" data-uppercase>{eyebrow}</p>}
      {title && <h2 class="sec-title">{title}</h2>}
      {lede && <p class="sec-lede">{lede}</p>}
    </header>
  )}
  <slot />
</section>

<style>
  .sec { padding-block: clamp(4.5rem, 12vh, 10rem); }
  .sec.tight { padding-block: clamp(2.5rem, 7vh, 5.5rem); }
  .sec-head { display: grid; gap: 1.1rem; margin-block-end: clamp(2rem, 5vh, 4rem); max-inline-size: 62ch; }
  .sec-center .sec-head { justify-items: center; text-align: center; margin-inline: auto; }

  .eyebrow {
    margin: 0; font-family: var(--font-display);
    font-size: var(--type-descriptor); letter-spacing: var(--track-cities);
    text-transform: uppercase; color: var(--bronze);
  }
  .sec-title {
    margin: 0; font-family: var(--font-display); font-weight: 300;
    font-size: clamp(1.9rem, 4.6vw, 3.6rem); line-height: 1.1;
    letter-spacing: 0.01em; color: #EDE7DA; text-wrap: balance;
  }
  .sec-lede {
    margin: 0; font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.5vw, 1.2rem); line-height: 1.85;
    color: var(--silver); max-inline-size: 58ch;
  }
</style>
